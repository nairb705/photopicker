{
  "outputDirectory": ".",
  "buildCommand": "npm install",
  "functions": {
    "api/analyze.js": {
      "memory": 1024,
      "maxDuration": 60
    },
    "api/suggest.js": {
      "memory": 256,
      "maxDuration": 15
    }
  },
  "rewrites": [
    { "source": "/api/analyze", "destination": "/api/analyze" },
    { "source": "/api/suggest", "destination": "/api/suggest" }
  ]
}